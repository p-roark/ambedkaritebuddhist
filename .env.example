# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-min-32-chars

# ─── Cloudflare D1 (via wrangler.toml) ────────────────────────────────────────
# For local `next dev`, add these to .env.local.
# The database_name and database_id also go into wrangler.toml [[d1_databases]].
#
# Needed by Drizzle Kit (db:generate / db:studio against remote D1):
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_DATABASE_ID=your-d1-database-id
CLOUDFLARE_D1_TOKEN=your-cloudflare-api-token

# ─── Admin Seed ────────────────────────────────────────────────────────────────
ADMIN_EMAIL=pankaj9um@gmail.com
ADMIN_PASSWORD=admin123
ADMIN_REFERRAL_CODE=BHIM-ABC-7K2M

# ─── Google APIs ──────────────────────────────────────────────────────────────
# Required to display images from public Google Drive folders in the gallery.
# Enable the "Google Drive API" in your Google Cloud project and create an
# API key (restrict it to the Drive API and your domain for security).
# The Drive folder must be shared as "Anyone with the link can view".
GOOGLE_DRIVE_API_KEY=

# ─── OAuth Providers (optional) ───────────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
