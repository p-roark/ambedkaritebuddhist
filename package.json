{
  "name": "ambedkarite-buddhist-community",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "opennextjs-cloudflare build",
    "workers:build": "opennextjs-cloudflare build",
    "workers:deploy": "opennextjs-cloudflare build && wrangler deploy",
    "pages:dev": "opennextjs-cloudflare preview",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote-dev": "wrangler d1 migrations apply DB --remote",
    "db:migrate:remote-prod": "wrangler d1 migrations apply DB-PROD --remote",
    "db:studio": "drizzle-kit studio",
    "db:seed:local": "wrangler d1 execute DB --local --file=./seeds/seed.sql",
    "db:seed:remote": "wrangler d1 execute DB --remote --file=./seeds/seed.sql"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.18.0",
    "drizzle-orm": "^0.38.3",
    "next": "^16.2.1",
    "next-auth": "5.0.0-beta.30",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "styled-jsx": "^5.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260317.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "^10.4.16",
    "drizzle-kit": "^0.29.1",
    "esbuild": "^0.27.4",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.0.10",
    "jsdom": "^23.0.0",
    "postcss": "^8.4.32",
    "prettier": "^3.1.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "vitest": "^1.0.0",
    "wrangler": "^4.76.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
